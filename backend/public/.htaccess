<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------------
    # Proxy/TLS detection.
    # cPanel (LiteSpeed, Cloudflare orange-cloud, most shared hosts) terminate
    # HTTPS at a proxy and forward HTTP to Apache with X-Forwarded-Proto set.
    # Laravel therefore believes the request is insecure, and
    # URL::forceScheme('https') answers with a 301 to https://... which the
    # proxy sends back as plain HTTP. Result: ERR_TOO_MANY_REDIRECTS on every
    # page. `HTTPS on` tells PHP this request was already secure.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [NC]
    RewriteRule ^ - [E=HTTPS:on]

    # Same for the cPanel vhost's own SSL variable on some hosts.
    RewriteCond %{HTTP:X-Forwarded-SSL} =on [NC]
    RewriteRule ^ - [E=HTTPS:on]

    # -----------------------------------------------------------------------
    # Normalise the SCRIPT_NAME so Laravel can build correct URLs.
    #
    # When this file is reached through public_html/.htaccess, PHP reports
    # SCRIPT_NAME as "/public/index.php" and Laravel's asset()/url() helpers
    # would emit /public/storage/... and /public/assets/... — those are 404s,
    # which is why profile photos break on shared hosting.
    #
    # The root .htaccess stashes the public-relative path in myapp.request_uri
    # via `RewriteRule ^(.*)$ public/index.php$1 [QSA|L]`. Rebuilding REQUEST_URI
    # from it here makes Laravel see "/storage/profiles/x.jpg" with
    # SCRIPT_NAME "/index.php", exactly as it would with a proper document root.
    #
    # When Apache serves this directly (document root already = backend/public)
    # myapp.request_uri is never set and these rules no-op.
    # -----------------------------------------------------------------------
    RewriteCond %{ENV:myapp.request_uri} ^(/.+)$
    RewriteRule ^ - [E=REQUEST_URI:%1]

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Handle Authorization Header (Sanctum Bearer tokens). The stock Laravel
    # rewrite used a malformed %{HTTP...on} pattern and never worked.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    # Skipped for the front controller: the public_html router rewrites "/" to
    # "index.php/", and without this guard the rule answers with a PUBLIC 301 to
    # /backend/public/index.php, exposing the internal path in the address bar.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# cPanel routes /up to Apache's health check only when this file resolves.
# Prevent directory listings if mod_negotiation is missing.
<IfModule !mod_negotiation.c>
    Options -Indexes
</IfModule>

# The SPA shell is generated by the deploy script, never cached.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
